#!/usr/bin/env bash
# kwin-saturation — adjust the Saturation Boost effect on a running KWin.
#
# Usage: kwin-saturation <value>   (e.g. 1.25)
#   value 1.0 = neutral, >1 = more vibrant, <1 = desaturated
#
# Writes the value into kwinrc and asks KWin to reconfigure only this effect,
# so the change applies immediately without restarting the compositor.
set -euo pipefail

VALUE="${1:-}"
if [[ -z "$VALUE" ]]; then
	CURRENT=$(kreadconfig6 --file kwinrc --group "Effect-saturationeffect" --key "Saturation" --default "1.0")
	echo "current saturation: $CURRENT"
	echo "usage: kwin-saturation <value> (e.g. 1.25)" >&2
	exit 1
fi

QDBUS=''
for candidate in qdbus6 qdbus-qt6 /usr/lib/qt6/bin/qdbus /usr/lib64/qt6/bin/qdbus; do
	if command -v "$candidate" >/dev/null 2>&1; then
		QDBUS="$candidate"
		break
	fi
done
if [[ -z "$QDBUS" ]]; then
	echo "Qt 6 qdbus was not found. Install qt6-tools (Arch), qdbus-qt6 (Debian/Ubuntu), or qt6-qttools (Fedora)." >&2
	exit 1
fi

kwriteconfig6 --file kwinrc --group "Effect-saturationeffect" --key "Enabled" "true"
kwriteconfig6 --file kwinrc --group "Effect-saturationeffect" --key "Saturation" "$VALUE"
"$QDBUS" org.kde.KWin /Effects org.kde.kwin.Effects.reconfigureEffect saturationeffect
echo "saturation set to $VALUE"
